{% extends 'layout.html.twig' %}
{% import '_gauge.html.twig' as gauge %}
{% import '_icons.html.twig' as ui %}

{% block title %}Meridian — {{ t('nav.sources') }}{% endblock %}

{% block style %}
  /* The map section is a <details>: the section head is its summary. */
  .mapsection { margin-top: 2rem; }
  .mapsection > summary { list-style: none; cursor: pointer; }
  .mapsection > summary::-webkit-details-marker { display: none; }
  .mapsection > summary .toggle { color: var(--muted); display: inline-flex; align-self: center; }
  .mapsection > summary .toggle .icon { width: 1rem; height: 1rem; vertical-align: 0; transition: transform .15s ease; }
  .mapsection[open] > summary .toggle .icon { transform: rotate(90deg); }
  .mapsection > summary:hover .toggle { color: var(--accent); }
  .mapwrap {
    background: var(--surface); border: 1px solid var(--line); border-radius: .45rem;
    padding: 1rem; overflow-x: auto;
  }
  .mapwrap svg { display: block; width: 100%; height: auto; min-width: 560px; }
  .mapwrap .axislabel { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; fill: var(--muted); }
  .mapwrap .bandline { stroke: var(--line); stroke-dasharray: 2 5; }
  .mapwrap .point text { font-size: 11px; fill: var(--ink); paint-order: stroke; stroke: var(--surface); stroke-width: 3px; stroke-linejoin: round; }
  .mapwrap .point text.n { stroke: none; fill: var(--surface); }
  .mapwrap .point:hover circle { stroke: var(--accent); stroke-width: 2.5; }
  .mapwrap .point:hover text { fill: var(--accent); font-weight: 600; }
  .maplegend { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; margin-top: .7rem; font-size: .74rem; color: var(--muted); }
  .maplegend .sw { display: inline-block; width: .6rem; height: .6rem; border-radius: 50%; margin-right: .3rem; }
  .mapindex { margin: .7rem 0 0; padding-top: .6rem; border-top: 1px solid var(--line); font-size: .74rem; color: var(--muted); }
  .mapindex ol {
    margin: .3rem 0 0; padding: 0; list-style: none;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: .2rem .9rem;
  }
  .mapindex li { display: flex; align-items: baseline; gap: .4rem; color: var(--ink); }
  .mapindex .n {
    flex-shrink: 0; min-width: 1.35rem; text-align: center; border-radius: 999px;
    color: var(--surface); font-size: .66rem; font-weight: 700; line-height: 1.35rem; align-self: center;
  }

  .srcgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr)); gap: .8rem; }
  .srccard .head { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .srccard .head .favicon { align-self: center; }
  .srccard .head h3 { margin: 0; font-size: 1rem; font-weight: 700; }
  .srccard .head h3 a { text-decoration: none; }
  .srccard .head h3 a:hover { color: var(--accent); text-decoration: underline; }
  .srccard .head .cc { font-size: .72rem; color: var(--muted); letter-spacing: .08em; }
  .srccard .head .pill { margin-left: auto; }
  .srccard .gauges { display: flex; flex-wrap: wrap; gap: .8rem; font-size: .66rem; color: var(--muted); }
  .srccard dl {
    margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .15rem .8rem;
    font-size: .76rem; border-top: 1px solid var(--line); padding-top: .55rem;
  }
  .srccard dt { color: var(--muted); }
  .srccard dd { margin: 0; }
  .srccard details { font-size: .74rem; color: var(--muted); }
  .srccard details summary { cursor: pointer; color: var(--accent); font-weight: 600; }
  .evidence { margin: .4rem 0 0; padding-left: 1.1rem; }
  .evidence li { margin-bottom: .45rem; }
  .evidence a { color: var(--accent); word-break: break-all; }
  .detaildialog .evidence { margin: 0; color: var(--ink); }
  .confidence-low { color: var(--econ-0); font-weight: 600; }
  .srccard .dissent { border-top: 1px solid var(--line); padding-top: .5rem; font-size: .74rem; }
  .srccard .dissent a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .srccard .dissent a:hover { text-decoration: underline; }
{% endblock %}

{% block content %}
<header class="masthead">
  <div class="kicker">{{ t('sources.kicker') }}</div>
  <h1>{{ t('sources.title', sources|length) }}</h1>
  <div class="meta-row">
    {% for perspective, count in perspective_counts %}
      <span class="stat"><b>{{ count }}</b> {{ label_perspective(perspective) }}</span>
    {% endfor %}
  </div>
  <p class="promise">{{ t('sources.intro') }}</p>
</header>

<main id="main">
  <details class="mapsection" id="map" open>
    <summary class="sectionhead">
      <span class="titling">
        <h2>{{ t('sources.map_title') }}</h2>
        <span class="context"><span class="count">{{ t('sources.map_sub') }}</span></span>
      </span>
      <span class="spread">
        <span class="label">{{ t('sources.grid_label') }}</span>
        {% include '_axis_grid.html.twig' with {
          'grid': dataset_grid,
          'aria': t('sources.grid_aria', sources|length),
        } only %}
        <span class="toggle">{{ ui.icon('chevron-right') }}</span>
      </span>
    </summary>
    <div class="mapwrap">
      {# Band edges follow Spectrum\Band: ±0.5 and ±1.75 on the -3..+3 axes. #}
      {% set xb = [50, 183.3, 316.7, 423.3, 556.7, 690] %}
      {% set yb = [30, 109.2, 188.3, 251.7, 330.8, 410] %}
      <svg viewBox="0 0 720 460" role="img" aria-label="{{ t('sources.map_aria') }}">
        {# Band strips in the gauge colours: economic along the bottom, GAL–TAN up the left. #}
        {% for i in 0..4 %}
          <rect x="{{ xb[i] }}" y="414" width="{{ (xb[i + 1] - xb[i])|number_format(1, '.', '') }}" height="5" rx="1.5" fill="var(--econ-{{ i }})" fill-opacity=".6"/>
          <rect x="41" y="{{ yb[i] }}" width="5" height="{{ (yb[i + 1] - yb[i])|number_format(1, '.', '') }}" rx="1.5" fill="var(--cult-{{ 4 - i }})" fill-opacity=".6"/>
        {% endfor %}
        {% for i in 1..4 %}
          <line class="bandline" x1="{{ xb[i] }}" y1="30" x2="{{ xb[i] }}" y2="410"/>
          <line class="bandline" x1="50" y1="{{ yb[i] }}" x2="690" y2="{{ yb[i] }}"/>
        {% endfor %}
        <rect x="50" y="30" width="640" height="380" rx="3" fill="none" stroke="var(--line)"/>
        <line x1="50" y1="220" x2="690" y2="220" stroke="var(--line-strong)"/>
        <line x1="370" y1="30" x2="370" y2="410" stroke="var(--line-strong)"/>

        <text class="axislabel" x="50" y="437">{{ t('sources.map_left') }}</text>
        <text class="axislabel" x="370" y="437" text-anchor="middle">{{ t('sources.map_centre') }}</text>
        <text class="axislabel" x="690" y="437" text-anchor="end">{{ t('sources.map_right') }}</text>
        <text class="axislabel" x="34" y="40" text-anchor="end">TAN</text>
        <text class="axislabel" x="34" y="410" text-anchor="end">GAL</text>

        {% for point in map_points %}
          {% set r = point.source.rating %}
          <g class="point" role="img" aria-label="{{ point.source.name }} — {{ rating_summary(r) }}">
            <title>{{ point.source.name }} — {{ rating_summary(r) }} · {{ t('sources.reliability_summary', r.reliability) }} · {{ t('sources.confidence_summary', t('grade.' ~ r.confidence)) }}</title>
            <circle cx="{{ point.cx|number_format(1, '.', '') }}" cy="{{ point.cy|number_format(1, '.', '') }}" r="{{ point.r }}"
                    fill="var(--persp-{{ point.source.perspective }})" fill-opacity="0.85"
                    stroke="var(--surface)" stroke-width="1.5"/>
            {% if point.number is null %}
            <text x="{{ point.lx|number_format(1, '.', '') }}" y="{{ point.ly|number_format(1, '.', '') }}"
                  text-anchor="{{ point.anchor }}">{{ point.source.name }}</text>
            {% else %}
            <text class="n" x="{{ point.cx|number_format(1, '.', '') }}" y="{{ (point.cy + 2.6)|number_format(1, '.', '') }}" font-size="{{ point.number < 10 ? 8 : 7 }}" font-weight="700"
                  text-anchor="middle">{{ point.number }}</text>
            {% endif %}
          </g>
        {% endfor %}
      </svg>
      <div class="maplegend">
        <span><span class="sw" style="background: var(--persp-dach)"></span>{{ label_perspective('dach') }}</span>
        <span><span class="sw" style="background: var(--persp-europe)"></span>{{ label_perspective('europe') }}</span>
        <span><span class="sw" style="background: var(--persp-global-south)"></span>{{ label_perspective('global-south') }}</span>
        <span><span class="sw" style="background: var(--persp-international)"></span>{{ label_perspective('international') }}</span>
        <span>{{ t('sources.map_dotsize') }}</span>
        <span>{{ t('sources.map_axis_note') }}</span>
        <span>{{ t('sources.map_jitter') }}</span>
      </div>
      {% set numbered = map_points|filter(p => p.number is not null) %}
      {% if numbered is not empty %}
      <div class="mapindex">
        {{ t('sources.map_index') }}
        <ol>
          {% for point in numbered %}
          <li><span class="n" style="background: var(--persp-{{ point.source.perspective }})">{{ point.number }}</span> {{ point.source.name }}</li>
          {% endfor %}
        </ol>
      </div>
      {% endif %}
    </div>
  </details>

  <section>
    <div class="sectionhead">
      <h2>{{ t('sources.all_title') }}</h2>
      <span class="count">{{ t('sources.all_sub') }}</span>
    </div>
    <div class="srcgrid">
      {% for source in sources %}
      {% set r = source.rating %}
      <article class="card srccard">
        <div class="head">
          {% if favicons[source.id] is defined %}
            <img class="favicon" src="/favicons/{{ favicons[source.id] }}" alt="" width="14" height="14" loading="lazy">
          {% endif %}
          <h3><a href="{{ source.homepage }}" rel="noopener">{{ source.name }}</a></h3>
          <span class="cc">{{ source.country }}</span>
          <span class="pill persp-{{ source.perspective }}">{{ label_perspective(source.perspective) }}</span>
        </div>
        <div class="tags">
          <span class="tag">{{ label_economic(r.economic) }}</span>
          <span class="tag">{{ label_cultural(r.cultural) }}</span>
          <span class="tag">{{ label_eu(r.euStance) }}</span>
          <span class="tag">{{ label_state_influence(r.stateInfluence) }}</span>
        </div>
        <div class="gauges">
          {{ gauge.bar(t('axis.econ_short'), t('axis.economic_title') ~ ': ' ~ r.economic|decimal, r.economic, 'var(--econ-' ~ band_of(r.economic) ~ ')') }}
          {{ gauge.bar(t('axis.galtan_short'), t('axis.cultural_title') ~ ': ' ~ r.cultural|decimal, r.cultural, 'var(--cult-' ~ band_of(r.cultural) ~ ')') }}
          {{ gauge.bar(t('axis.eu_short'), t('axis.eu_title') ~ ': ' ~ r.euStance|decimal, r.euStance, 'var(--accent)') }}
        </div>
        <dl>
          <dt>{{ t('sources.reliability') }}</dt>
          <dd><span class="rel" role="img" aria-label="{{ r.reliability }}/5">{{ reliability_dots(r.reliability) }}</span> {{ r.reliability }}/5</dd>
          <dt>{{ t('party_family.label') }}</dt><dd>{{ label_party_family(r.partyFamily) }}</dd>
          <dt>{{ t('sources.publisher') }}</dt><dd>{{ source.publisher }}</dd>
          {% if source.wikidata %}
          <dt>{{ t('sources.wikidata') }}</dt><dd><a href="{{ source.wikidataUrl() }}" rel="noopener">{{ source.wikidata }}</a></dd>
          {% endif %}
          <dt>{{ t('sources.ownership') }}</dt><dd>{{ t('ownership.' ~ source.ownership) }} · {{ t('sources.funding') }}: {% for f in source.funding %}{{ t('funding.' ~ f) }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
          <dt>{{ t('sources.transparency') }}</dt><dd>{{ t('grade.' ~ r.transparency) }}</dd>
          <dt>{{ t('sources.confidence') }}</dt><dd class="{{ r.confidence == 'low' ? 'confidence-low' }}">{{ t('grade.' ~ r.confidence) }}</dd>
          <dt>{{ t('sources.topics') }}</dt><dd>{% for topic in source.topics %}{{ label_topic(topic) }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
          <dt>{{ t('sources.in_focus') }}</dt><dd>{{ (in_focus[source.id] ?? 0) == 1 ? t('sources.in_focus_value_one') : t('sources.in_focus_value', in_focus[source.id] ?? 0) }}</dd>
        </dl>
        {% if r.evidence %}
        <details class="modal" data-title="{{ source.name }}">
          <summary>{{ t('sources.evidence', r.evidence|length) }}</summary>
          <ul class="evidence">
            {% for e in r.evidence %}
              <li><a href="{{ e.url }}" rel="noopener">{{ e.url }}</a><br>{{ e.note }}</li>
            {% endfor %}
          </ul>
        </details>
        {% endif %}
        {% if viewer.accountsEnabled %}
        <p class="dissent"><a href="/report?source={{ source.id }}">{{ t('report.link_source') }}</a></p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </section>
</main>
{% endblock %}

{% block script %}
<script>
  // Remember a collapsed map per browser; the page renders it open.
  (function () {
    var map = document.getElementById('map');
    if (!map) return;
    try {
      if (localStorage.getItem('meridian-map') === 'closed') map.open = false;
      map.addEventListener('toggle', function () {
        localStorage.setItem('meridian-map', map.open ? 'open' : 'closed');
      });
    } catch (e) {}
  })();
</script>
{% endblock %}

{% block footer %}
  <p class="enough">{{ t('sources.footer_title') }}</p>
  <p>{{ t('sources.footer_text') }}</p>
{% endblock %}
