{% extends 'layout.html.twig' %}

{% block title %}Meridian — {{ t('watchlist.title_short') }}{% endblock %}

{% block style %}
  .saved { display: flex; flex-direction: column; gap: .5rem; }
  .saved .item {
    display: grid; grid-template-columns: 1fr auto; gap: .5rem 1rem; align-items: start;
    background: var(--surface); border: 1px solid var(--line); border-radius: .45rem;
    padding: .75rem .9rem;
  }
  .saved h3 { margin: 0 0 .3rem; font-size: .95rem; font-weight: 600; line-height: 1.4; }
  .saved h3 a { text-decoration: none; }
  .saved h3 a:hover { color: var(--accent); text-decoration: underline; }
  .saved .meta {
    display: flex; flex-wrap: wrap; gap: .3rem .8rem; font-size: .72rem; color: var(--muted);
  }
  .saved .meta .src { font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ink); }
  .empty { max-width: 42rem; margin: 2.5rem auto; text-align: center; color: var(--muted); font-size: .9rem; }
  .empty a { color: var(--accent); }
{% endblock %}

{% block content %}
<header class="masthead">
  <div class="kicker">{{ t('watchlist.kicker') }}</div>
  <h1>{{ t('watchlist.title') }}</h1>
  <div class="meta-row">
    <span class="stat"><b>{{ entries|length }}</b> / {{ max_entries }} {{ t('watchlist.stat_slots') }}</span>
  </div>
  <p class="promise">{{ t('watchlist.intro', max_entries) }}</p>
</header>

<main id="main">
  {% if full %}
    <div class="notice"><strong>{{ t('watchlist.full_strong') }}</strong> {{ t('watchlist.full_text', max_entries) }}</div>
  {% endif %}

  {% if entries is empty %}
    <div class="empty">
      {{ t('watchlist.empty') }}
      <p><a href="/">{{ t('watchlist.empty_link') }}</a></p>
    </div>
  {% else %}
    <section style="margin-top: 1.2rem">
      <div class="sectionhead">
        <h2>{{ t('watchlist.list_title') }}</h2>
        <span class="count">{{ t('watchlist.list_sub') }}</span>
      </div>
      <div class="saved">
        {% for entry in entries %}
          <article class="item">
            <div>
              <h3><a href="{{ entry.ref.url }}" rel="noopener" data-article="{{ entry.ref.url }}">{{ entry.ref.title }}</a></h3>
              <div class="meta">
                <span class="src">{{ entry.source ? entry.source.name : entry.ref.sourceId }}</span>
                {% if entry.source %}
                  <span>{{ label_perspective(entry.source.perspective) }}</span>
                  <span>{{ rating_summary(entry.source.rating) }}</span>
                {% endif %}
                <span>{{ label_topic(entry.ref.topic) }}</span>
                <span>{{ t('watchlist.saved_at', entry.ref.at|shortdate) }}</span>
              </div>
            </div>
            <form method="post" action="/watchlist">
              <input type="hidden" name="_csrf" value="{{ viewer.csrfToken }}">
              <input type="hidden" name="action" value="remove">
              <input type="hidden" name="url" value="{{ entry.ref.url }}">
              <input type="hidden" name="return" value="/watchlist">
              <button class="btn quiet" type="submit">{{ t('watchlist.remove') }}</button>
            </form>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</main>
{% endblock %}

{% block footer %}
  <p class="enough">{{ t('watchlist.footer_title') }}</p>
  <p>{{ t('watchlist.footer_text', max_entries) }}</p>
{% endblock %}
