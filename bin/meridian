#!/usr/bin/env php
<?php

declare(strict_types=1);

use Meridian\Console\AccountsPruneCommand;
use Meridian\Console\EditionsArchiveCommand;
use Meridian\Console\FaviconsFetchCommand;
use Meridian\Console\FetchCommand;
use Meridian\Console\ReportsListCommand;
use Meridian\Console\SourcesListCommand;
use Meridian\Console\SourcesValidateCommand;
use Meridian\Services;
use Symfony\Component\Console\Application;

require dirname(__DIR__) . '/vendor/autoload.php';

$services = new Services(dirname(__DIR__));

$app = new Application('meridian', '0.1.0');
$app->addCommand(new FetchCommand($services));
$app->addCommand(new FaviconsFetchCommand($services));
$app->addCommand(new EditionsArchiveCommand($services));
$app->addCommand(new SourcesListCommand($services));
$app->addCommand(new SourcesValidateCommand($services));
$app->addCommand(new AccountsPruneCommand($services));
$app->addCommand(new ReportsListCommand($services));
$app->run();
